{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starrank",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://starrank.lol"
  },
  "routes": [
    {
      "pattern": "starrank.lol/*",
      "zone_name": "starrank.lol"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starrank-db",
      "database_id": "51af159d-4584-44e2-86ef-78ba6424536b",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RESOLVE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
